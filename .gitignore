/console
/console.yaml
/console.local.yaml
*.db
*.db-*

# Frontend build artefacts. web/dist is committed empty: the build output is
# content-hashed, so committing it means a rewritten bundle in every UI diff,
# and the Dockerfile rebuilds it regardless. .gitkeep is what //go:embed needs
# to find, so `go build` works without node.
/web/dist/*
!/web/dist/.gitkeep
/web/node_modules/
/web/vendor/*/*/node_modules/
/web/*.tsbuildinfo
/web/.next/
/web/out/

# Local npm auth for the private @riseaicloud/* registry — never commit
.npmrc

# The image built from this working copy (hack/image.sh)
/console-image.yaml

# Locally packaged Helm charts
/dist/

# Second UI-kit build (npm run build:shadcn); only web/dist is embedded.
web/dist-shadcn/
