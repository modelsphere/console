{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    // The more specific pattern wins, so the ui kit resolves separately from the
    // rest of the module. tsconfig.shadcn.json checks the other one.
    "paths": {
      "@/*": ["./src/*"],
      "@swiss/components/ui/*": ["./src/modules/swiss/components/ui/rise/*"],
      "@swiss/*": ["./src/modules/swiss/*"]
    }
  },
  "include": ["src", "vite.config.ts", "tailwind.config.ts"]
}
