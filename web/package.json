{
  "name": "console-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:shadcn": "tsc -p tsconfig.shadcn.json && UI_KIT=shadcn vite build --outDir dist-shadcn",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.shadcn.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@riseaicloud/tokens": "file:./vendor/@riseaicloud/tokens",
    "@riseaicloud/ui": "file:./vendor/@riseaicloud/ui",
    "@tanstack/react-query": "^5.103.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "@riseaicloud/tokens": "file:./vendor/@riseaicloud/tokens",
    "@riseaicloud/ui": "file:./vendor/@riseaicloud/ui"
  }
}
